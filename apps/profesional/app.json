{
  "expo": {
    "name": "Doctor Ker",
    "slug": "kerhub-profesional",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kerhub-profesional",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "co.branzontech.kerhub.profesional",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#8b35e9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "co.branzontech.kerhub.profesional"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#8b35e9",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 170
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Doctor Ker registra tu ubicación al salir hacia el paciente y al llegar, como constancia de la visita."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
